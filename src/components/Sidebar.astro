---
interface ItemNav {
  numero: string;
  etiqueta: string;
  ancla: string;
}

interface Props {
  nombre: string;
  items: ItemNav[];
}

const { nombre, items } = Astro.props;
---

<aside class="sidebar">
  <div class="sidebar__inner">
    <a href="#top" class="sidebar__name mono">{nombre}</a>

    <nav class="sidebar__nav" aria-label="Secciones">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={`#${item.ancla}`}>
                <span class="sidebar__num">{item.numero}</span>
                <span class="sidebar__link-label">{item.etiqueta}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</aside>

<style>
  .sidebar {
    border-right: 1px solid var(--color-line);
  }

  .sidebar__inner {
    position: sticky;
    top: 0;
    padding: 7rem 1.75rem 2rem;
  }

  .sidebar__name {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 2.5rem;
  }

  .sidebar__nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .sidebar__nav a {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.03em;
    color: var(--color-muted);
    transition: color 0.15s ease;
  }

  .sidebar__nav a:hover {
    color: var(--color-text);
  }

  .sidebar__num {
    color: var(--color-faint);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 60rem) {
    .sidebar {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .sidebar__inner {
      position: static;
      padding: 1.75rem 1.5rem;
    }

    .sidebar__name {
      margin-bottom: 1.5rem;
    }

    .sidebar__nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }
  }
</style>
