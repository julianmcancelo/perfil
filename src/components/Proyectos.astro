---
import type { Proyecto } from "../data/perfil.ts";

interface Props {
  proyectos: Proyecto[];
}

const { proyectos } = Astro.props;
---

<section id="proyectos" class="section reveal">
  <header class="section__head">
    <h2 class="section__title mono">01 &mdash; proyectos</h2>

    <div class="deck__nav" data-deck-nav>
      <span class="deck__contador mono" data-contador>1 / {proyectos.length}</span>
      <button
        class="deck__btn"
        type="button"
        data-prev
        aria-label="Proyecto anterior"
      >
        &larr;
      </button>
      <button
        class="deck__btn"
        type="button"
        data-next
        aria-label="Proyecto siguiente"
      >
        &rarr;
      </button>
    </div>
  </header>

  <div class="deck" data-deck aria-roledescription="carrusel">
    <ol class="deck__pista">
      {
        proyectos.map((p, i) => (
          <li
            class="tarjeta"
            data-card
            data-nombre={p.nombre}
            style={`--i:${i}`}
          >
            <div class="tarjeta__top">
              <span class="tarjeta__marca mono">{p.sigla ?? p.nombre.slice(0, 2)}</span>
              {p.destacado && (
                <span class="pill pill--fill">{p.destacado}</span>
              )}
            </div>

            {p.etiquetas && p.etiquetas.length > 0 && (
              <p class="tarjeta__tags">
                {p.etiquetas.map((t) => (
                  <span class="pill">{t}</span>
                ))}
              </p>
            )}

            <h3 class="tarjeta__nombre mono">{p.nombre}</h3>
            <p class="tarjeta__desc">{p.descripcion}</p>

            <div class="tarjeta__pie">
              {p.href ? (
                <a
                  class="arrow-link"
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                >
                  Abrir proyecto
                </a>
              ) : (
                <span class="tarjeta__nota label">Repositorio privado</span>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="deck__vivo sr-only" aria-live="polite" data-vivo></p>
</section>

<style>
  .section {
    padding: 3.5rem 0;
    border-top: 1px solid var(--color-line);
  }

  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.25rem;
  }

  .section__title {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-faint);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* --- Controles ---------------------------------------- */

  .deck__nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .deck__contador {
    font-size: 0.75rem;
    color: var(--color-faint);
    font-variant-numeric: tabular-nums;
  }

  .deck__btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--color-line-strong);
    border-radius: 3px;
    width: 1.85rem;
    height: 1.85rem;
    display: grid;
    place-items: center;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .deck__btn:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }

  /* --- Pila de tarjetas -------------------------------- */

  .deck {
    --peek: 6.5rem;
    --peek-2: 10rem;
    --rot: 6deg;
    position: relative;
    overflow: hidden;
  }

  .deck__pista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tarjeta {
    background: var(--color-bg);
    border: 1px solid var(--color-line-strong);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 1px 2px rgb(10 10 10 / 0.05);
  }

  /* Sin JS: lista vertical legible. */
  .deck:not(.deck--listo) .tarjeta + .tarjeta {
    margin-top: 1rem;
  }

  /* Con JS: pila superpuesta. */
  .deck--listo {
    height: 22.5rem;
  }

  .deck--listo .deck__pista {
    position: absolute;
    inset: 0;
  }

  .deck--listo .tarjeta {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(100%, 21rem);
    height: 100%;
    display: flex;
    flex-direction: column;
    transform: translateX(-50%);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.45s ease,
      filter 0.45s ease,
      box-shadow 0.45s ease;
    will-change: transform;
  }

  .deck--listo .tarjeta:not([data-pos="0"]) {
    filter: blur(1.5px);
  }

  .deck--listo .tarjeta[data-pos="0"] {
    transform: translateX(-50%) rotate(0) scale(1);
    opacity: 1;
    z-index: 30;
    border-color: var(--color-muted);
    box-shadow: 0 12px 32px rgb(10 10 10 / 0.12);
  }

  .deck--listo .tarjeta[data-pos="-1"] {
    transform: translateX(calc(-50% - var(--peek))) rotate(calc(-1 * var(--rot)))
      scale(0.92);
    opacity: 0.45;
    z-index: 20;
  }

  .deck--listo .tarjeta[data-pos="1"] {
    transform: translateX(calc(-50% + var(--peek))) rotate(var(--rot)) scale(0.92);
    opacity: 0.45;
    z-index: 20;
  }

  .deck--listo .tarjeta[data-pos="-2"] {
    transform: translateX(calc(-50% - var(--peek-2)))
      rotate(calc(-1.6 * var(--rot))) scale(0.84);
    opacity: 0.18;
    z-index: 10;
  }

  .deck--listo .tarjeta[data-pos="2"] {
    transform: translateX(calc(-50% + var(--peek-2))) rotate(calc(1.6 * var(--rot)))
      scale(0.84);
    opacity: 0.18;
    z-index: 10;
  }

  .deck--listo .tarjeta[data-pos="oculta"] {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) scale(0.8);
  }

  .deck--listo .tarjeta:not([data-pos="0"]) {
    cursor: pointer;
  }

  /* --- Contenido de la tarjeta ------------------------- */

  .tarjeta__top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .tarjeta__marca {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    white-space: nowrap;
  }

  .pill--fill {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .tarjeta__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .tarjeta__nombre {
    font-size: 1.125rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
  }

  .tarjeta__desc {
    color: rgb(var(--g600));
    font-size: 0.9375rem;
    line-height: 1.55;
    overflow: hidden;
  }

  .deck--listo .tarjeta__desc {
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
  }

  .tarjeta__pie {
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .tarjeta__nota {
    color: var(--color-faint);
  }

  @media (max-width: 60rem) {
    .deck {
      --peek: 3rem;
      --peek-2: 4.75rem;
      --rot: 4deg;
    }
    .deck--listo {
      height: 26rem;
    }
    .deck--listo .tarjeta {
      width: min(100%, 17.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck--listo .tarjeta {
      transition: none;
    }
  }
</style>

<script>
  const deck = document.querySelector<HTMLElement>("[data-deck]");
  if (deck) {
    const cartas = Array.from(
      deck.querySelectorAll<HTMLElement>("[data-card]"),
    );
    const btnPrev = document.querySelector<HTMLButtonElement>("[data-prev]");
    const btnNext = document.querySelector<HTMLButtonElement>("[data-next]");
    const contador = document.querySelector<HTMLElement>("[data-contador]");
    const vivo = document.querySelector<HTMLElement>("[data-vivo]");
    const total = cartas.length;
    let activo = 0;

    const soportaInert = "inert" in HTMLElement.prototype;

    const pintar = () => {
      cartas.forEach((carta, i) => {
        let d = i - activo;
        if (d > total / 2) d -= total;
        if (d < -total / 2) d += total;

        const pos = Math.abs(d) <= 2 ? String(d) : "oculta";
        carta.dataset.pos = pos;

        const esActiva = d === 0;
        carta.setAttribute("aria-hidden", String(!esActiva));
        carta.tabIndex = esActiva ? 0 : -1;
        if (soportaInert) carta.inert = !esActiva;
      });

      if (contador) contador.textContent = `${activo + 1} / ${total}`;
      if (vivo)
        vivo.textContent = `Proyecto ${activo + 1} de ${total}: ${
          cartas[activo].dataset.nombre ?? ""
        }`;
    };

    const ir = (delta: number) => {
      activo = (activo + delta + total) % total;
      pintar();
    };

    btnPrev?.addEventListener("click", () => ir(-1));
    btnNext?.addEventListener("click", () => ir(1));

    cartas.forEach((carta, i) => {
      carta.addEventListener("click", (ev) => {
        if (i !== activo) {
          ev.preventDefault();
          activo = i;
          pintar();
        }
      });
    });

    deck.addEventListener("keydown", (ev) => {
      if (ev.key === "ArrowLeft") ir(-1);
      if (ev.key === "ArrowRight") ir(1);
    });

    deck.classList.add("deck--listo");
    pintar();
  }
</script>
