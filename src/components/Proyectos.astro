---
import type { Proyecto } from "../data/perfil.ts";

interface Props {
  proyectos: Proyecto[];
}

const { proyectos } = Astro.props;
---

<section id="proyectos" class="section reveal">
  <header class="section__head">
    <h2 class="section__title mono">01 &mdash; proyectos</h2>

    <div class="deck__nav">
      <span class="deck__contador mono" data-contador
        >01 / {String(proyectos.length).padStart(2, "0")}</span
      >
      <button
        class="deck__btn"
        type="button"
        data-prev
        aria-label="Proyecto anterior"
      >
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path
            d="M10 3 5 8l5 5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <button
        class="deck__btn"
        type="button"
        data-next
        aria-label="Proyecto siguiente"
      >
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path
            d="M6 3l5 5-5 5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </header>

  <div class="deck" data-deck aria-roledescription="carrusel">
    <ol class="deck__pista">
      {
        proyectos.map((p, i) => (
          <li class="tarjeta" data-card data-nombre={p.nombre}>
            <div class="tarjeta__top">
              <span class="tarjeta__marca mono">
                {p.sigla ?? p.nombre.slice(0, 2)}
              </span>
              {p.destacado && (
                <span class="pill pill--fill tarjeta__solo-activa">
                  {p.destacado}
                </span>
              )}
            </div>

            <h3 class="tarjeta__nombre mono">{p.nombre}</h3>

            <div class="tarjeta__cuerpo tarjeta__solo-activa">
              {p.etiquetas && p.etiquetas.length > 0 && (
                <p class="tarjeta__tags">
                  {p.etiquetas.map((t) => (
                    <span class="pill">{t}</span>
                  ))}
                </p>
              )}

              <p class="tarjeta__desc">{p.descripcion}</p>
            </div>

            <div class="tarjeta__pie tarjeta__solo-activa">
              {p.enlaces && p.enlaces.length > 0 ? (
                <div class="tienda">
                  {p.enlaces.map((e) => (
                    <a
                      class="tienda__btn"
                      href={e.href}
                      target="_blank"
                      rel="noopener"
                    >
                      <svg
                        class="tienda__glifo"
                        viewBox="0 0 16 16"
                        width="13"
                        height="13"
                        aria-hidden="true"
                      >
                        {e.tipo === "play" && <path d="M3 1.8v12.4l10.5-6.2z" fill="currentColor" />}
                        {e.tipo === "apple" && (
                          <path
                            d="M11 8.5c0-1.9 1.5-2.8 1.6-2.9-.9-1.3-2.2-1.4-2.7-1.5-1.1-.1-2.2.7-2.8.7-.6 0-1.5-.7-2.4-.6-1.2 0-2.3.7-3 1.8-1.3 2.2-.3 5.6 1 7.4.6.9 1.4 1.9 2.4 1.9 1 0 1.3-.6 2.5-.6s1.5.6 2.5.6c1 0 1.7-.9 2.3-1.8.4-.6.7-1.2.9-1.9-.1 0-1.8-.7-1.8-2.6zM9.4 3.6c.5-.7.9-1.6.8-2.6-.8 0-1.7.5-2.3 1.2-.5.6-.9 1.5-.8 2.4.9.1 1.8-.4 2.3-1z"
                            fill="currentColor"
                          />
                        )}
                        {e.tipo !== "play" && e.tipo !== "apple" && (
                          <g fill="none" stroke="currentColor" stroke-width="1.3">
                            <circle cx="8" cy="8" r="6" />
                            <path d="M2 8h12M8 2c2 2.2 2 9.8 0 12M8 2c-2 2.2-2 9.8 0 12" />
                          </g>
                        )}
                      </svg>
                      <span>{e.etiqueta}</span>
                    </a>
                  ))}
                </div>
              ) : p.href ? (
                <a
                  class="arrow-link"
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                >
                  Abrir proyecto
                </a>
              ) : (
                <span class="tarjeta__nota label">Repositorio privado</span>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="deck__ticks" role="tablist" aria-label="Elegir proyecto">
    {
      proyectos.map((p, i) => (
        <button
          class="deck__tick"
          type="button"
          role="tab"
          data-tick={i}
          aria-label={p.nombre}
          aria-selected={i === 0 ? "true" : "false"}
        />
      ))
    }
  </div>

  <p class="deck__vivo sr-only" aria-live="polite" data-vivo></p>
</section>

<style>
  .section {
    padding: 3.5rem 0;
    border-top: 1px solid var(--color-line);
  }

  .section__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section__title {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-faint);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* --- Controles --------------------------------------- */

  .deck__nav {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .deck__contador {
    font-size: 0.75rem;
    color: var(--color-faint);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .deck__btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--color-line-strong);
    border-radius: 4px;
    width: 1.9rem;
    height: 1.9rem;
    display: grid;
    place-items: center;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .deck__btn:hover {
    color: var(--color-bg);
    background: var(--color-text);
    border-color: var(--color-text);
  }

  .deck__btn:active {
    transform: translateY(1px);
  }

  /* --- Pila de tarjetas ------------------------------- */

  .deck {
    --peek: 6rem;
    --peek-2: 9.5rem;
    --rot: 5deg;
    position: relative;
    overflow: hidden;
  }

  .deck__pista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tarjeta {
    background: var(--color-bg);
    border: 1px solid var(--color-line-strong);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 1px 2px rgb(10 10 10 / 0.05);
  }

  /* Sin JS: lista vertical legible. */
  .deck:not(.deck--listo) .tarjeta + .tarjeta {
    margin-top: 1rem;
  }

  /* Con JS: pila superpuesta. */
  .deck--listo {
    height: 22.5rem;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 8%,
      #000 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 8%,
      #000 92%,
      transparent 100%
    );
    cursor: grab;
  }

  .deck--listo.deck--arrastrando {
    cursor: grabbing;
  }

  .deck--listo .deck__pista {
    position: absolute;
    inset: 0;
  }

  .deck--listo .tarjeta {
    position: absolute;
    top: 0;
    left: 50%;
    width: min(100%, 21rem);
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transform: translateX(-50%);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.4s ease,
      box-shadow 0.45s ease,
      border-color 0.3s ease;
    will-change: transform;
  }

  /* En las tarjetas del fondo solo se ve la marca y el título. */
  .deck--listo .tarjeta__solo-activa {
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .deck--listo .tarjeta[data-pos="0"] .tarjeta__solo-activa {
    opacity: 1;
    pointer-events: auto;
  }

  .deck--listo .tarjeta[data-pos="0"] {
    transform: translateX(-50%) rotate(0) scale(1);
    opacity: 1;
    z-index: 30;
    border-color: var(--color-muted);
    box-shadow: 0 14px 34px rgb(10 10 10 / 0.13);
  }

  .deck--listo .tarjeta[data-pos="-1"] {
    transform: translateX(calc(-50% - var(--peek))) rotate(calc(-1 * var(--rot)))
      scale(0.9);
    opacity: 0.66;
    z-index: 20;
  }

  .deck--listo .tarjeta[data-pos="1"] {
    transform: translateX(calc(-50% + var(--peek))) rotate(var(--rot)) scale(0.9);
    opacity: 0.66;
    z-index: 20;
  }

  .deck--listo .tarjeta[data-pos="-2"] {
    transform: translateX(calc(-50% - var(--peek-2)))
      rotate(calc(-1.5 * var(--rot))) scale(0.8);
    opacity: 0.32;
    z-index: 10;
  }

  .deck--listo .tarjeta[data-pos="2"] {
    transform: translateX(calc(-50% + var(--peek-2))) rotate(calc(1.5 * var(--rot)))
      scale(0.8);
    opacity: 0.32;
    z-index: 10;
  }

  .deck--listo .tarjeta[data-pos="oculta"] {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) scale(0.75);
  }

  .deck--listo .tarjeta:not([data-pos="0"]) {
    cursor: pointer;
  }

  @media (hover: hover) {
    .deck--listo .tarjeta[data-pos="0"]:hover {
      transform: translateX(-50%) translateY(-3px) scale(1);
    }
  }

  /* --- Contenido de la tarjeta ----------------------- */

  .tarjeta__top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .tarjeta__marca {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    white-space: nowrap;
  }

  .pill--fill {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .tarjeta__nombre {
    font-size: 1.125rem;
    font-weight: 400;
    margin-bottom: 0.9rem;
  }

  .tarjeta__cuerpo {
    flex: 1;
    min-height: 0;
  }

  .tarjeta__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.9rem;
  }

  .tarjeta__desc {
    color: rgb(var(--g600));
    font-size: 0.9375rem;
    line-height: 1.55;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
  }

  .deck--listo .tarjeta__desc {
    -webkit-line-clamp: 4;
  }

  .tarjeta__pie {
    padding-top: 1.1rem;
  }

  .tarjeta__nota {
    color: var(--color-faint);
  }

  .tienda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tienda__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-text);
    color: var(--color-bg);
    border: 1px solid var(--color-text);
    border-radius: 6px;
    padding: 0.3rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .tienda__btn:hover {
    background: transparent;
    color: var(--color-text);
  }

  .tienda__glifo {
    flex-shrink: 0;
  }

  /* --- Indicadores ---------------------------------- */

  .deck__ticks {
    display: flex;
    gap: 0.4rem;
    margin-top: 1.5rem;
  }

  .deck__tick {
    appearance: none;
    border: 0;
    background: var(--color-line-strong);
    height: 2px;
    width: 1.5rem;
    padding: 0;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      width 0.2s ease;
  }

  .deck__tick:hover {
    background: var(--color-muted);
  }

  .deck__tick[aria-selected="true"] {
    background: var(--color-text);
    width: 2.75rem;
  }

  @media (max-width: 60rem) {
    .deck {
      --peek: 2.75rem;
      --peek-2: 4.5rem;
      --rot: 3.5deg;
    }
    .deck--listo {
      height: 24.5rem;
    }
    .deck--listo .tarjeta {
      width: min(100%, 17rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck--listo .tarjeta {
      transition: opacity 0.2s ease;
    }
    .deck--listo .tarjeta[data-pos="0"]:hover {
      transform: translateX(-50%);
    }
  }
</style>

<script>
  const deck = document.querySelector<HTMLElement>("[data-deck]");
  if (deck) {
    const cartas = Array.from(deck.querySelectorAll<HTMLElement>("[data-card]"));
    const btnPrev = document.querySelector<HTMLButtonElement>("[data-prev]");
    const btnNext = document.querySelector<HTMLButtonElement>("[data-next]");
    const ticks = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-tick]"),
    );
    const contador = document.querySelector<HTMLElement>("[data-contador]");
    const vivo = document.querySelector<HTMLElement>("[data-vivo]");
    const total = cartas.length;
    const soportaInert = "inert" in HTMLElement.prototype;
    let activo = 0;

    const dosDigitos = (n: number) => String(n).padStart(2, "0");

    const pintar = () => {
      cartas.forEach((carta, i) => {
        let d = i - activo;
        if (d > total / 2) d -= total;
        if (d < -total / 2) d += total;

        carta.dataset.pos = Math.abs(d) <= 2 ? String(d) : "oculta";

        const esActiva = d === 0;
        carta.setAttribute("aria-hidden", String(!esActiva));
        carta.tabIndex = esActiva ? 0 : -1;
        if (soportaInert) carta.inert = !esActiva;
      });

      ticks.forEach((t, i) =>
        t.setAttribute("aria-selected", String(i === activo)),
      );

      if (contador)
        contador.textContent = `${dosDigitos(activo + 1)} / ${dosDigitos(total)}`;
      if (vivo)
        vivo.textContent = `Proyecto ${activo + 1} de ${total}: ${
          cartas[activo].dataset.nombre ?? ""
        }`;
    };

    const irA = (indice: number) => {
      activo = ((indice % total) + total) % total;
      pintar();
    };
    const ir = (delta: number) => irA(activo + delta);

    btnPrev?.addEventListener("click", () => ir(-1));
    btnNext?.addEventListener("click", () => ir(1));
    ticks.forEach((t, i) => t.addEventListener("click", () => irA(i)));

    cartas.forEach((carta, i) => {
      carta.addEventListener("click", (ev) => {
        if (i !== activo) {
          ev.preventDefault();
          irA(i);
        }
      });
    });

    deck.addEventListener("keydown", (ev) => {
      if (ev.key === "ArrowLeft") ir(-1);
      else if (ev.key === "ArrowRight") ir(1);
    });

    // Arrastrar / deslizar para cambiar de tarjeta.
    let inicioX: number | null = null;
    let movido = false;

    deck.addEventListener("pointerdown", (ev) => {
      if ((ev.target as HTMLElement).closest("a")) return;
      inicioX = ev.clientX;
      movido = false;
    });
    deck.addEventListener("pointermove", (ev) => {
      if (inicioX !== null && Math.abs(ev.clientX - inicioX) > 6) movido = true;
    });
    const soltar = (ev: PointerEvent) => {
      if (inicioX === null) return;
      const dx = ev.clientX - inicioX;
      inicioX = null;
      deck.classList.remove("deck--arrastrando");
      if (Math.abs(dx) > 45) ir(dx < 0 ? 1 : -1);
    };
    deck.addEventListener("pointerup", soltar);
    deck.addEventListener("pointercancel", soltar);
    deck.addEventListener("pointerleave", soltar);
    deck.addEventListener("dragstart", (ev) => ev.preventDefault());
    // Evita que un arrastre dispare el clic de "traer al frente".
    deck.addEventListener(
      "click",
      (ev) => {
        if (movido) {
          ev.stopPropagation();
          ev.preventDefault();
          movido = false;
        }
      },
      true,
    );

    deck.classList.add("deck--listo");
    pintar();
  }
</script>
