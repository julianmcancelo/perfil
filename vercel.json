{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "astro build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.juliancancelo.com.ar" }],
      "destination": "https://juliancancelo.com.ar/:path*",
      "permanent": true
    }
  ]
}
